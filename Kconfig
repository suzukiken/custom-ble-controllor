# Loaded via zephyr/module.yml (ZMK_EXTRA_MODULES = this repo).

config ZMK_SOAK_STATUS
	bool "HID soak status on status-key press"
	depends on ZMK_BATTERY_REPORTING
	help
	  When the status matrix position is pressed (RP2040 virtual finger),
	  type: time: <uptime_s>, power=<percent>, mode=<label> + Enter

if ZMK_SOAK_STATUS

config ZMK_SOAK_STATUS_POSITION
	int "Matrix position that triggers status typing"
	default 0
	range 0 15
	help
	  Position index in the keymap (0 = D0 status key).

config ZMK_SOAK_STATUS_MODE
	string "Mode label in status line (mode=<label>)"
	default "sleep" if ZMK_SLEEP
	default "awake"

endif

config ZMK_POWER_DRAIN
	bool "Maximize power draw for battery drain tests"
	depends on ZMK_BATTERY_REPORTING
	help
	  Keep CPU busy, drive onboard RGB LEDs, spam HID, and periodically
	  type time/power so you can stop around ~50% SoC.

if ZMK_POWER_DRAIN

config ZMK_POWER_DRAIN_HID_MS
	int "HID spam interval (ms)"
	default 40
	range 10 1000

config ZMK_POWER_DRAIN_STATUS_MS
	int "Status line interval (ms)"
	default 30000
	range 5000 600000

endif
